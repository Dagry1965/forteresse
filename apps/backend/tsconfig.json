{
  "compilerOptions": {
    "module": "CommonJS",
    "target": "ES2022",
    "lib": ["ES2022"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "outDir": "dist",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "sourceMap": true,

    "baseUrl": "./src",
    "paths": {
      "@core/*": ["core/*"],
      "@common/*": ["core/common/*"],
      "@constants/*": ["core/common/constants/*"],
      "@modules/*": ["modules/*"],
      "@prisma/*": ["core/prisma/*"],
      "@shared/*": ["../../packages/shared/*"]
    }
  },

  "include": [
    "src/**/*"
  ]
}