generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ====================== MODELS ======================

model Workspace {
  id               String            @id @default(cuid())
  name             String
  created_at       DateTime          @default(now())
  updated_at       DateTime          @updatedAt
  businessSettings BusinessSettings?

  members          WorkspaceMember[]
  users            User[]
  clients          Client[]
  clientContacts   ClientContact[]
  vehicles         Vehicle[]
  appointments     Appointment[]
  suppliers        Supplier[]
  stock            StockMovement[]
  purchaseOrders   PurchaseOrder[]
  purchaseReceipts PurchaseReceipt[]
  proformas        Proforma[]
  invoices         Invoice[]
  payments         Payment[]
  timeslots        TimeSlot[]
  refreshTokens    RefreshToken[]
  interventions    Intervention[]
  StockCategory    StockCategory[]
  StockItem        StockItem[]
  StockReception   StockReception[]
  Inventory        Inventory[]
  cases            Case[]
  numberSequence   NumberSequence[]
  paymentSchedules PaymentSchedule[] // ← obligatoire
}

model User {
  id         String    @id @default(cuid())
  email      String    @unique
  name       String
  password   String
  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  deleted_at DateTime?

  workspace_id String
  workspace    Workspace @relation(fields: [workspace_id], references: [id])

  createdAppointments   Appointment[]   @relation("AppointmentCreatedBy")
  updatedAppointments   Appointment[]   @relation("AppointmentUpdatedBy")
  createdInvoices       Invoice[]       @relation("InvoiceCreatedBy")
  updatedInvoices       Invoice[]       @relation("InvoiceUpdatedBy")
  createdStockMovements StockMovement[] @relation("StockMovementCreatedBy")
  createdPurchaseOrders PurchaseOrder[] @relation("PurchaseOrderCreatedBy")

  RefreshTokens    RefreshToken[]
  Appointments     Appointment[]
  Invoices         Invoice[]
  Payments         Payment[]
  workspaceMembers WorkspaceMember[]
  AuditLogs        AuditLog[]

  @@index([workspace_id])
  @@index([email])
}

model WorkspaceMember {
  id         String    @id @default(cuid())
  role       String    @default("MEMBER")
  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  deleted_at DateTime?

  workspace_id String
  workspace    Workspace @relation(fields: [workspace_id], references: [id])

  user_id String
  user    User   @relation(fields: [user_id], references: [id])

  @@index([workspace_id])
}

model Client {
  id    String @id @default(cuid())
  name  String
  phone String
  email String
  type  String @default("INDIVIDUAL")

  company_name        String?
  trade_name          String?
  registration_number String?
  vat_number          String?
  address             String?
  billing_address     String?
  payment_terms_days  Int     @default(0)
  credit_limit        Float?

  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  deleted_at DateTime?

  workspace_id String
  workspace    Workspace @relation(fields: [workspace_id], references: [id])

  contacts     ClientContact[]
  cases        Case[]          @relation("ClientToCase")
  vehicles     Vehicle[]
  appointments Appointment[]
  invoices     Invoice[]
  payments     Payment[]

  @@index([workspace_id])
  @@index([workspace_id, type])
  @@index([email])
  @@index([registration_number])
  @@index([vat_number])
}

model ClientContact {
  id String @id @default(cuid())

  first_name String
  last_name  String
  role       String?
  email      String?
  phone      String?

  is_primary        Boolean @default(false)
  receives_proforma Boolean @default(false)
  receives_invoice  Boolean @default(false)

  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  deleted_at DateTime?

  workspace_id String
  workspace    Workspace @relation(fields: [workspace_id], references: [id])

  client_id String
  client    Client @relation(fields: [client_id], references: [id])

  @@index([workspace_id])
  @@index([client_id])
  @@index([client_id, is_primary])
}

model Vehicle {
  id           String @id @default(cuid())
  registration String
  brand        String
  model        String
  status       String @default("DISPONIBLE")

  fleet_number String?
  vin          String?
  year         Int?
  mileage      Int?
  usual_driver String?
  cost_center  String?
  service_name String?

  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  deleted_at DateTime?

  workspace_id String
  workspace    Workspace @relation(fields: [workspace_id], references: [id])

  client_id String
  client    Client @relation(fields: [client_id], references: [id])

  appointments Appointment[]
  cases        Case[]        @relation("VehicleToCase")

  @@index([workspace_id])
  @@index([client_id])
  @@index([workspace_id, registration])
  @@index([workspace_id, fleet_number])
  @@index([workspace_id, vin])
}

model TimeSlot {
  id           String    @id @default(cuid())
  start        DateTime
  end          DateTime
  created_at   DateTime  @default(now())
  updated_at   DateTime  @updatedAt
  deleted_at   DateTime?
  status       String    @default("OPEN")
  occupancy    Int       @default(0)
  workspace_id String
  workspace    Workspace @relation(fields: [workspace_id], references: [id])

  appointments Appointment[]

  @@index([workspace_id])
  @@index([workspace_id, start])
}

model Appointment {
  id         String    @id @default(cuid())
  date       DateTime
  status     String    @default("PENDING")
  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  deleted_at DateTime?

  created_by String?
  updated_by String?

  workspace_id String
  workspace    Workspace @relation(fields: [workspace_id], references: [id])

  client_id String
  client    Client @relation(fields: [client_id], references: [id])

  vehicle_id String
  vehicle    Vehicle @relation(fields: [vehicle_id], references: [id])

  time_slot_id String
  time_slot    TimeSlot @relation(fields: [time_slot_id], references: [id])

  user_id String
  user    User   @relation(fields: [user_id], references: [id])

  createdBy User? @relation("AppointmentCreatedBy", fields: [created_by], references: [id])
  updatedBy User? @relation("AppointmentUpdatedBy", fields: [updated_by], references: [id])

  invoices   Invoice[]
  proformas  Proforma[]
  repairCase Case?

  @@index([workspace_id])
  @@index([workspace_id, status])
  @@index([workspace_id, date])
  @@index([client_id])
  @@index([vehicle_id])
}

model Proforma {
  id         String    @id @default(cuid())
  reference  String
  total      Float
  status     String    @default("DRAFT")
  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  deleted_at DateTime?

  customer_name_snapshot                String?
  customer_address_snapshot             String?
  customer_billing_address_snapshot     String?
  customer_registration_number_snapshot String?
  customer_vat_number_snapshot          String?
  customer_email_snapshot               String?
  customer_phone_snapshot               String?

  workspace_id String
  workspace    Workspace @relation(fields: [workspace_id], references: [id])

  appointment_id String
  appointment    Appointment @relation(fields: [appointment_id], references: [id])

  case_id String?
  case    Case?   @relation(fields: [case_id], references: [id])

  invoices Invoice[]
  lines    ProformaLine[]

  @@unique([workspace_id, reference])
  @@index([workspace_id])
  @@index([appointment_id])
}

model Invoice {
  id         String    @id @default(cuid())
  reference  String
  total      Float
  status     String    @default("DRAFT")
  type       String    @default("PROFORMA")
  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  deleted_at DateTime?

  customer_name_snapshot                String?
  customer_address_snapshot             String?
  customer_billing_address_snapshot     String?
  customer_registration_number_snapshot String?
  customer_vat_number_snapshot          String?
  customer_email_snapshot               String?
  customer_phone_snapshot               String?

  created_by String?
  updated_by String?

  workspace_id String
  workspace    Workspace @relation(fields: [workspace_id], references: [id])

  proforma_id String?
  proforma    Proforma? @relation(fields: [proforma_id], references: [id])

  appointment_id String?
  appointment    Appointment? @relation(fields: [appointment_id], references: [id])

  user_id String?
  user    User?   @relation(fields: [user_id], references: [id])

  client_id String?
  client    Client? @relation(fields: [client_id], references: [id])

  createdBy User? @relation("InvoiceCreatedBy", fields: [created_by], references: [id])
  updatedBy User? @relation("InvoiceUpdatedBy", fields: [updated_by], references: [id])

  payments         Payment[]
  lines            InvoiceLine[]
  paymentSchedules PaymentSchedule[] // <-- AJOUTER CETTE LIGNE

  @@unique([workspace_id, reference])
  @@index([workspace_id])
  @@index([workspace_id, status])
  @@index([client_id])
  @@index([created_at])
}

model Payment {
  id         String    @id @default(cuid())
  amount     Float
  method     String
  paid_at    DateTime  @default(now())
  reference  String?
  notes      String?
  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  deleted_at DateTime?

  workspace_id String
  workspace    Workspace @relation(fields: [workspace_id], references: [id])

  invoice_id String
  invoice    Invoice @relation(fields: [invoice_id], references: [id])

  client_id String
  client    Client @relation(fields: [client_id], references: [id])

  user_id String
  user    User   @relation(fields: [user_id], references: [id])

  @@index([workspace_id])
  @@index([invoice_id])
  @@index([client_id])
  @@index([paid_at])
}

model Intervention {
  id          String    @id @default(cuid())
  description String
  status      String    @default("PENDING")
  created_at  DateTime  @default(now())
  updated_at  DateTime  @updatedAt
  deleted_at  DateTime?

  workspace_id String
  workspace    Workspace @relation(fields: [workspace_id], references: [id])

  // Lien vers le dossier (Case)
  case_id String?
  case    Case?   @relation(fields: [case_id], references: [id])

  InterventionPart InterventionPart[]

  @@index([workspace_id])
  @@index([case_id])
}

model Supplier {
  id           String    @id @default(cuid())
  name         String
  email        String?
  phone        String?
  workspace_id String
  workspace    Workspace @relation(fields: [workspace_id], references: [id])

  items          StockItem[]
  purchaseOrders PurchaseOrder[]

  @@index([workspace_id])
}

model StockCategory {
  id           String      @id @default(cuid())
  name         String
  workspace_id String
  workspace    Workspace   @relation(fields: [workspace_id], references: [id])
  items        StockItem[]

  @@index([workspace_id])
}

model StockItem {
  id           String    @id @default(cuid())
  name         String
  reference    String?
  description  String?
  category_id  String?
  supplier_id  String?
  price_buy    Float
  price_sell   Float
  quantity     Int       @default(0)
  workspace_id String
  deleted_at   DateTime?
  unit         String    @default("unite") // ex: "litre", "pièce", "heure"
  min_stock    Int       @default(0) // Seuil d'alerte pour le dashboard

  category  StockCategory? @relation(fields: [category_id], references: [id])
  supplier  Supplier?      @relation(fields: [supplier_id], references: [id])
  workspace Workspace      @relation(fields: [workspace_id], references: [id])

  movements      StockMovement[]
  purchaseItems  PurchaseOrderItem[]
  inventoryItems InventoryItem[]
  interventions  InterventionPart[]

  @@index([workspace_id])
  @@index([category_id])
  @@index([supplier_id])
}

model StockMovement {
  id           String   @id @default(cuid())
  type         String
  quantity     Int
  item_id      String
  workspace_id String
  created_at   DateTime @default(now())

  created_by String?
  createdBy  User?   @relation("StockMovementCreatedBy", fields: [created_by], references: [id])

  item      StockItem @relation(fields: [item_id], references: [id])
  workspace Workspace @relation(fields: [workspace_id], references: [id])

  @@index([workspace_id])
  @@index([item_id])
}

model PurchaseOrder {
  id           String    @id @default(cuid())
  reference    String
  status       String    @default("DRAFT")
  supplier_id  String
  workspace_id String
  created_at   DateTime  @default(now())
  deleted_at   DateTime?

  created_by String?
  createdBy  User?   @relation("PurchaseOrderCreatedBy", fields: [created_by], references: [id])

  supplier         Supplier            @relation(fields: [supplier_id], references: [id])
  workspace        Workspace           @relation(fields: [workspace_id], references: [id])
  items            PurchaseOrderItem[]
  receptions       StockReception[]
  purchaseReceipts PurchaseReceipt[]

  @@unique([workspace_id, reference])
  @@index([workspace_id])
  @@index([workspace_id, status])
  @@index([supplier_id])
}

model PurchaseOrderItem {
  id                String @id @default(cuid())
  purchase_order_id String
  item_id           String
  quantity          Int
  received_quantity Int    @default(0) //
  price_buy         Float

  purchaseOrder PurchaseOrder @relation(fields: [purchase_order_id], references: [id])
  item          StockItem     @relation(fields: [item_id], references: [id])

  @@index([purchase_order_id])
  @@index([item_id])
}

model StockReception {
  id                String   @id @default(cuid())
  purchase_order_id String
  received_at       DateTime @default(now())
  workspace_id      String

  purchaseOrder PurchaseOrder @relation(fields: [purchase_order_id], references: [id])
  workspace     Workspace     @relation(fields: [workspace_id], references: [id])

  @@index([workspace_id])
  @@index([purchase_order_id])
}

model PurchaseReceipt {
  id         String   @id @default(cuid())
  reference  String
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  workspace_id String
  workspace    Workspace @relation(fields: [workspace_id], references: [id])

  purchase_order_id String
  purchase_order    PurchaseOrder @relation(fields: [purchase_order_id], references: [id])

  @@unique([workspace_id, reference])
  @@index([workspace_id])
  @@index([purchase_order_id])
}

model Inventory {
  id           String   @id @default(cuid())
  reference    String
  created_at   DateTime @default(now())
  workspace_id String

  workspace Workspace       @relation(fields: [workspace_id], references: [id])
  items     InventoryItem[]

  @@unique([workspace_id, reference])
  @@index([workspace_id])
}

model InventoryItem {
  id           String @id @default(cuid())
  inventory_id String
  item_id      String
  counted      Int
  expected     Int

  inventory Inventory @relation(fields: [inventory_id], references: [id])
  item      StockItem @relation(fields: [item_id], references: [id])

  @@index([inventory_id])
  @@index([item_id])
}

model InterventionPart {
  id              String @id @default(cuid())
  intervention_id String
  item_id         String
  quantity        Int
  price_snapshot  Float

  intervention Intervention @relation(fields: [intervention_id], references: [id])
  item         StockItem    @relation(fields: [item_id], references: [id])

  @@index([intervention_id])
  @@index([item_id])
}

model RefreshToken {
  id         String   @id @default(cuid())
  token_hash String
  expires_at DateTime
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  workspace_id String
  workspace    Workspace @relation(fields: [workspace_id], references: [id])

  user_id String
  user    User   @relation(fields: [user_id], references: [id])

  @@index([workspace_id])
  @@index([user_id])
}

model AuditLog {
  id         String   @id @default(cuid())
  action     String
  entity     String
  entity_id  String
  old_data   String?
  new_data   String?
  created_at DateTime @default(now())

  user_id String?
  user    User?   @relation(fields: [user_id], references: [id])

  @@index([entity, entity_id])
  @@index([created_at])
}

model BusinessSettings {
  id            String @id @default(cuid())
  openingTime   String @default("08:00")
  closingTime   String @default("18:00")
  slotDuration  Int    @default(30)
  maxConcurrent Int    @default(2)

  // Stocké en string (ex: "1,2,3,4,5,6") car SQLite ne supporte pas les tableaux
  workingDays String @default("1,2,3,4,5,6")

  workspace_id String    @unique
  workspace    Workspace @relation(fields: [workspace_id], references: [id])

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
}

model Case {
  id         String   @id @default(cuid())
  reference  String
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  workspace_id String
  workspace    Workspace @relation(fields: [workspace_id], references: [id])

  status String @default("RECEIVED")

  // Relation Client (Définie UNE SEULE FOIS)
  customer_id String?
  client      Client? @relation("ClientToCase", fields: [customer_id], references: [id])

  // Relation Véhicule (Définie UNE SEULE FOIS)
  vehicle_id String?
  vehicle    Vehicle? @relation("VehicleToCase", fields: [vehicle_id], references: [id])

  title       String?
  description String?

  appointment_id String?      @unique
  appointment    Appointment? @relation(fields: [appointment_id], references: [id])

  interventions Intervention[]
  proformas     Proforma[]

  @@unique([workspace_id, reference])
  @@index([workspace_id])
  @@index([workspace_id, status])
}

model ProformaLine {
  id String @id @default(cuid())

  proforma_id String
  proforma    Proforma @relation(fields: [proforma_id], references: [id])

  type String

  label String

  description String?

  quantity Decimal @default(1)

  unit_price Decimal

  vat_rate Decimal

  discount Decimal @default(0)

  total Decimal

  created_at DateTime @default(now())

  @@index([proforma_id])
}

model InvoiceLine {
  id String @id @default(cuid())

  invoice_id String
  invoice    Invoice @relation(fields: [invoice_id], references: [id])

  type String

  label String

  description String?

  quantity Decimal

  unit_price Decimal

  vat_rate Decimal

  discount Decimal

  total Decimal

  created_at DateTime @default(now())

  @@index([invoice_id])
}

model NumberSequence {
  id String @id @default(cuid())

  workspace_id String
  workspace    Workspace @relation(fields: [workspace_id], references: [id], onDelete: Cascade)

  prefix String

  year Int

  last_number Int @default(0)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@unique([workspace_id, prefix, year])
  @@index([workspace_id])
}

model PaymentSchedule {
  id         String   @id @default(cuid())
  invoice_id String
  amount     Float // Montant attendu pour cette tranche
  due_date   DateTime // Date limite de paiement pour cette tranche
  status     String   @default("PENDING") // PENDING, PAID, OVERDUE

  invoice      Invoice   @relation(fields: [invoice_id], references: [id])
  workspace_id String
  workspace    Workspace @relation(fields: [workspace_id], references: [id])

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@index([invoice_id])
  @@index([workspace_id])
}

model BackupLog {
  id String @id @default(cuid())

  file_name String?

  status String

  destination String?

  error_message String?

  created_at DateTime @default(now())

  @@index([status])
  @@index([created_at])
}
